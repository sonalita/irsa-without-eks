# Copy to .env and edit: cp .env.example .env
# .env is gitignored. Keep only non-secret configuration here.

AWS_ACCOUNT_NUMBER=123456789012
AWS_PROFILE=my-sso-profile
AWS_REGION=eu-west-2

CLUSTER_NAME=oidc-parameter-store-demo

# OPTIONAL Cloudflare Pages project name to publish the OIDC discovery document and public key to.
CLOUDFLARE_PAGES_PROJECT=my-oidc-pages

# A subdomain under your control, e.g. oidcdemo.example.com
OIDC_HOST=oidcdemo.example.com

# OPTIONAL kubectl context for cloudflarepublish.sh (default: kind-$CLUSTER_NAME)
#KUBE_CONTEXT=
